^SAMPLE = GSM8159506
!Sample_title = leaves, GW_Mock1
!Sample_geo_accession = GSM8159506
!Sample_status = Public on Sep 22 2024
!Sample_submission_date = Mar 21 2024
!Sample_last_update_date = Sep 22 2024
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = leaves
!Sample_organism_ch1 = Litchi chinensis
!Sample_taxid_ch1 = 151069
!Sample_characteristics_ch1 = tissue: leaves
!Sample_characteristics_ch1 = genotype: GW
!Sample_characteristics_ch1 = treatment: Mock treatment
!Sample_treatment_protocol_ch1 = Lychee leaves were inoculated with P.litchii (1 × 104 spores·mL-1) or mock-inoculation (sterile water).
!Sample_growth_protocol_ch1 = Lychee trees were planted in national lychee germplasm nursery located in institute of fruit tree research Guangdong Academy of Agricultural Aciences.
!Sample_molecule_ch1 = total RNA
!Sample_extract_protocol_ch1 = RNA was extracted using the TRIzol method (Invitrogen, CA, USA) and treated with RNase-free DNase I (Takara, Kusatsu, Japan). A total amount of 1.5 μg RNA per sample was used as input material for the RNA sample preparations.
!Sample_extract_protocol_ch1 = Sequencing libraries were generated using NEBNext® Ultra™ RNA Library Prep Kit for Illumina® (NEB, USA) following manufacturer’s recommendations and index codes were added to attribute sequences to each sample.
!Sample_data_processing = Raw data (raw reads) of fastq format were firstly processed through in-house perl scripts.
!Sample_data_processing = The adaptor sequences and low-quality sequence reads were removed from the data sets. Raw sequences were transformed into clean reads after data processing. These clean reads were then mapped to the reference genome sequence by STAR. Only reads with a perfect match or one mismatch were further analyzed and annotated based on the reference genome.
!Sample_data_processing = Picard - tools v1.41 and samtools v0.1.18 were used to sort, remove duplicated reads and merge the bam alignment results of each sample.
!Sample_data_processing = HTSeq(v 0.5.4) was used to count the reads numbers mapped to each gene.
!Sample_data_processing = Assembly: The reference genome sequencing and assembly can be found in the NCBI database under accession number PRJNA747875.
!Sample_data_processing = Supplementary files format and content: tab-delimited text files include readcount values for each Sample.
!Sample_data_processing = Supplementary files format and content: tab-delimited text files include fpkm values for each Sample.
!Sample_platform_id = GPL32189
