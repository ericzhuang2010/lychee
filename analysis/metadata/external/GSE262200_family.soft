^SERIES = GSE262200
!Series_title = Transcription analysis of GW and SFZ lychees under lychee downy blight stress
!Series_geo_accession = GSE262200
!Series_status = Public on Sep 22 2024
!Series_submission_date = Mar 21 2024
!Series_last_update_date = Sep 22 2024
!Series_summary = Lychee (Litchi chinensis Sonn.) is a popular fruit worldwide. Lychee downy blight, caused by Peronophythora litchii (P. litchii), is one of the major diseases in lychee. In this study, we conducted a P. litchii infection experiment on the lychee leaves of GW and SFZ, and analyzed the mRNA in the treated leaves using transcriptome RNA sequencing technology. Our research will provide a preliminary basis for the prevention and control of lychee downy blight.
!Series_overall_design = The leaves from GW and SFZ were treated with P. litchii or mock (sterile water). The gene expression profiling analysis was performed based on data derived from RNA-seq of the treated samples.
!Series_type = Expression profiling by high throughput sequencing
!Series_contributor = Hailun,,Liu
