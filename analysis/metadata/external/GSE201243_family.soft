^SERIES = GSE201243
!Series_title = Transcriptome analysis of Litchi chinensis under inoculated with P.litchii treatments
!Series_geo_accession = GSE201243
!Series_status = Public on Aug 01 2022
!Series_submission_date = Apr 21 2022
!Series_last_update_date = Aug 01 2022
!Series_summary = To investigate the potential mechanism of disease resistance in Litchi, a genome-wide transcriptomic analysis was carried out using 'Guiwei' and 'Yurong1' Litchi under inoculated with P.litchii treatments.
!Series_overall_design = The gene expression profiling analysis using data obtained from RNA-seq of 'Guiwei' and 'Yurong1'. The treated leaves were collected at 24 hpi. RNA sequencing was performed by the Allwegene Technologies Corporation (Beijing, China) using an Illumina NovaSeq platform.
!Series_type = Expression profiling by high throughput sequencing
