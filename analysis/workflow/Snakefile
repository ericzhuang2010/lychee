configfile: "analysis/config/release.yaml"

import csv
from pathlib import Path


SAMPLE_TABLE = "analysis/metadata/PRJNA830488_samples.tsv"
with open(SAMPLE_TABLE) as handle:
    SAMPLE_ROWS = list(csv.DictReader(handle, delimiter="\t"))

SAMPLES = [row["sample_id"] for row in SAMPLE_ROWS]
ROW = {row["sample_id"]: row for row in SAMPLE_ROWS}
RUN = {sample: ROW[sample]["run"] for sample in SAMPLES}
RAW_DIR = "data/active_discovery/PRJNA830488/fastq"
TRIM_DIR = "data/active_discovery/PRJNA830488/trimmed"
ALIGN_DIR = "results/alignment/PRJNA830488"
SALMON_DIR = "results/quantification/PRJNA830488/salmon"
QC_DIR = "results/qc/PRJNA830488"
PATHWAY_GMT = "data/reference/pathways/frozen_plant_reactome_UP000059680/plant_reactome_litchi.gmt"
GENE_QC = f"{QC_DIR}/uniform_gene_mappability.tsv"
RAW_FASTQS = [
    f"{RAW_DIR}/{RUN[sample]}_{mate}.fastq.gz"
    for sample in SAMPLES
    for mate in (1, 2)
]


rule all:
    input:
        "results/quantification/PRJNA830488/gene_counts.tsv",
        "results/quantification/PRJNA830488/discovery_matrix.sha256",
        "results/audit/PRJNA830488_technical_qc.tsv",
        "results/audit/PRJNA830488_sample_decisions.tsv",
        f"{QC_DIR}/multiqc_report.html",
        expand(f"{SALMON_DIR}/{{sample}}/quant.sf", sample=SAMPLES),
        "results/discovery/frozen_results.sha256",
        "results/discovery/external_outcomes_unlock_timestamp.txt",
        "results/robustness/genes/frozen_gene_robustness.tsv",
        "results/robustness/pathways/frozen_pathway_robustness.tsv",
        "results/robustness/internal_results.sha256",
        "results/evidence/annotation/candidate_annotation_evidence.tsv",
        "results/evidence/annotation/annotation_results.sha256",
        "results/evidence/annotation/interpro_candidate_summary.tsv",
        "results/evidence/annotation/interpro_results.sha256",
        "results/evidence/annotation/final_candidate_annotations.tsv",
        "results/evidence/annotation/final_annotation.sha256",
        "results/evidence/motifs/results/motif_results.sha256",
        "results/evidence/small_rna/reference/small_rna_reference.sha256",
        "results/evidence/published/published_evidence.sha256",


rule download_discovery_fastq:
    output:
        marker=f"{RAW_DIR}/.download_complete",
        report="results/audit/PRJNA830488_fastq_download.tsv",
        fastqs=RAW_FASTQS,
    threads: 1
    resources:
        mem_mb=1000
    shell:
        """
        python analysis/scripts/04_download_fastq.py \
          --samples {SAMPLE_TABLE} \
          --outdir {RAW_DIR} \
          --report {output.report} \
          --minimum-free-bytes {config[minimum_free_bytes_before_study]} \
          --connections 4
        """


rule prepare_reference:
    input:
        host="data/reference/host/Lchinesis_genome.Chr.fasta.gz",
        gff="data/reference/host/Lchinesis_genome.Chr.gff3.gz",
        cds="data/reference/host/Lchinesis_genome.Chr.cds.gz",
        protein="data/reference/host/Lchinesis_genome.Chr.pep.gz",
        pathogen="data/reference/pathogen/GWHAOTU00000000.genome.fasta.gz",
    output:
        genome="data/reference/combined/host_pathogen.fa",
        gtf="data/reference/combined/host.annotation.gtf",
        transcripts="data/reference/combined/host.transcripts.fa",
        tx2gene="data/reference/combined/transcript_to_gene.tsv",
        canonical="data/reference/combined/canonical_transcripts.tsv",
        qc="data/reference/combined/reference_qc.tsv",
        checksums="data/reference/combined/reference_checksums.sha256",
    threads: 1
    resources:
        mem_mb=3000
    shell:
        "python analysis/scripts/02_prepare_reference.py"


rule combined_genome_faidx:
    input:
        genome=rules.prepare_reference.output.genome,
    output:
        "data/reference/combined/host_pathogen.fa.fai"
    threads: 1
    resources:
        mem_mb=1000
    shell:
        "samtools faidx {input.genome}"


rule star_index:
    input:
        genome=rules.prepare_reference.output.genome,
        gtf=rules.prepare_reference.output.gtf,
    output:
        genome="data/reference/indexes/star/Genome",
        sa="data/reference/indexes/star/SA",
        saindex="data/reference/indexes/star/SAindex",
    threads: config["star_threads"]
    resources:
        mem_mb=14000,
        alignment_slots=1
    shell:
        """
        mkdir -p data/reference/indexes/star
        STAR --runThreadN {threads} \
          --runMode genomeGenerate \
          --genomeDir data/reference/indexes/star \
          --genomeFastaFiles {input.genome} \
          --sjdbGTFfile {input.gtf} \
          --sjdbOverhang 149 \
          --genomeSAindexNbases 13 \
          --limitGenomeGenerateRAM 14000000000
        """


