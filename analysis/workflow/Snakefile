    threads: 1
    resources:
        mem_mb=3000
    shell:
        """
        python analysis/scripts/10_gene_mappability.py \
          --gtf {input.gtf} --bedgraph {input.bedgraph} \
          --config {input.config} --output {output.qc} \
          --selection {input.selection} --index-dir {input.index} \
          --checksum-manifest {output.manifest}
        sha256sum -c {output.manifest}
        """


