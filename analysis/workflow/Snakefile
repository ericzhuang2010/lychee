        salmon=expand(f"{SALMON_DIR}/{{sample}}/aux_info/meta_info.json", sample=SAMPLES),
    output:
        report="results/audit/PRJNA830488_technical_qc.tsv",
        decisions="results/audit/PRJNA830488_sample_decisions.tsv",
    threads: 1
    resources:
        mem_mb=1000
    shell:
