        genome=rules.prepare_reference.output.genome,
    output:
        directory("data/reference/indexes/genmap/combined")
    threads: 4
    resources:
        mem_mb=6000
    shell:
        """
        mkdir -p data/reference/indexes/genmap
        genmap index -F {input.genome} -I {output} \
          -A divsufsort -S 10 -v --version-check false
        """


rule genmap_host_exons:
    input:
        index=rules.genmap_index.output,
        selection=rules.mappability_selection.output.bed,
    output:
        "data/reference/mappability/combined_host_exons.bedgraph"
    threads: 8
    resources:
        mem_mb=8000
    shell:
        """
        genmap map -I {input.index} \
          -O data/reference/mappability/combined_host_exons \
          -K 100 -E 2 -S {input.selection} -bg -m -T {threads} -v \
          --version-check false
        """


rule uniform_gene_mappability:
