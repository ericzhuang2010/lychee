rule internal_gene_robustness:
    input:
        counts=rules.merge_featurecounts.output.counts,
        primary=rules.primary_discovery.output.genes,
        frozen=rules.freeze_discovery.output.genes,
        metadata=SAMPLE_TABLE,
        decisions=rules.collect_discovery_qc.output.decisions,
        quant=expand(f"{SALMON_DIR}/{{sample}}/quant.sf", sample=SAMPLES),
        tx2gene=rules.prepare_reference.output.tx2gene,
        mapping=rules.candidate_mapping_sensitivity.output.summary,
        config="analysis/config/discovery.yaml",
    output:
        genes="results/robustness/genes/frozen_gene_robustness.tsv",
        summary="results/robustness/genes/robustness_summary.tsv",
    threads: 4
    resources:
        mem_mb=14000
    shell:
        """
        Rscript analysis/scripts/12_internal_gene_robustness.R \
          --counts {input.counts} --primary-genes {input.primary} \
          --frozen-genes {input.frozen} --metadata {input.metadata} \
          --decisions {input.decisions} --salmon-root {SALMON_DIR} \
          --tx2gene {input.tx2gene} --mapping-sensitivity {input.mapping} \
          --config {input.config} \
          --outdir results/robustness/genes
        """


