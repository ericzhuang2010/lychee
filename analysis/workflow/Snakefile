        decisions=rules.collect_discovery_qc.output.decisions,
    output:
        "results/quantification/PRJNA830488/discovery_matrix.sha256"
    threads: 1
    resources:
        mem_mb=500
    shell:
        "sha256sum {input.counts} {input.annotation} {input.metadata} {input.qc} {input.decisions} > {output}"


