rule finalize_candidate_annotation:
    input:
        sequence=rules.candidate_sequence_annotation.output.evidence,
        interpro=rules.candidate_interpro_matches.output.summary,
        config="analysis/config/orthogonal_validation.yaml",
    output:
        table="results/evidence/annotation/final_candidate_annotations.tsv",
        summary="results/evidence/annotation/final_annotation_summary.md",
        manifest="results/evidence/annotation/final_annotation.sha256",
    threads: 1
    resources:
        mem_mb=500
    shell:
        """
        python analysis/scripts/33_finalize_annotation.py \
          --sequence-evidence {input.sequence} --interpro-summary {input.interpro} \
          --config {input.config} --outdir results/evidence/annotation
        sha256sum -c {output.manifest}
        """


