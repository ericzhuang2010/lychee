rule freeze_internal_robustness:
    input:
        discovery=rules.freeze_discovery.output.checksums,
        mapping=rules.candidate_mapping_sensitivity.output.summary,
        mapping_per_sample=rules.candidate_mapping_sensitivity.output.per_sample,
        genes=rules.internal_gene_robustness.output.genes,
        gene_summary=rules.internal_gene_robustness.output.summary,
        pathways=rules.internal_pathway_robustness.output.pathways,
        pathway_summary=rules.internal_pathway_robustness.output.summary,
    output:
        "results/robustness/internal_results.sha256"
    threads: 1
    resources:
        mem_mb=500
    shell:
        """
        sha256sum {input.discovery} {input.mapping} {input.mapping_per_sample} \
          {input.genes} {input.gene_summary} {input.pathways} \
          {input.pathway_summary} > {output}
        sha256sum -c {output}
        """
